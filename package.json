{
  "name": "marblehead-scripts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:minutes": "node --test scripts/minutes/lib/*.test.mjs",
    "test:transcripts": "node --test scripts/transcripts/lib/*.test.mjs",
    "transcripts:pull-vimeo": "node scripts/transcripts/pull_vimeo.mjs",
    "transcripts:backfill": "node scripts/transcripts/backfill_auto.mjs",
    "dev": "bundle exec jekyll serve --port 4000",
    "build": "bundle exec jekyll build && npx pagefind --site _site",
    "preview:search": "npm run build && npx serve _site -p 4001",
    "smoke:local": "SITE=http://localhost:4000 node tests/smoke-test.mjs",
    "test:parser": "cd data && python3 -m pytest -v",
    "test:local": "node scripts/test-local.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.90.0",
    "csv-parse": "^5.6.0",
    "csv-stringify": "^6.5.2",
    "p-limit": "^6.2.0",
    "playwright": "^1.59.1"
  },
  "devDependencies": {
    "pagefind": "^1.4.0",
    "serve": "^14.0.0",
    "wait-on": "^7.0.0"
  }
}
